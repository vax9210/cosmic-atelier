---
import { base, origin, jsonLD } from '../lib/site.js';
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, origin).href;
---
<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>{noindex&&<meta name="robots" content="noindex,follow"/>}<title>{title}｜Cosmic Atelier</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta name="twitter:card" content="summary"/><script type="application/ld+json" set:html={jsonLD({'@context':'https://schema.org','@type':'CollectionPage',name:title,description,url:canonical,inLanguage:'zh-Hant'})}/><style is:global>
body{margin:0;background:#070b17;color:#eaf0ff;font:17px/1.8 system-ui,sans-serif}main,header,footer{max-width:1100px;margin:auto;padding:24px}nav{display:flex;flex-wrap:wrap;gap:20px}a{color:#91e4f5}h1{font-size:clamp(2rem,6vw,3.6rem);line-height:1.2}p{color:#b9c8df}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:20px}.card{border:1px solid #30405f;border-radius:18px;padding:24px;background:#11192b;overflow-wrap:anywhere}.muted{color:#9fb0cc}input,select{font:inherit;color:inherit;background:#11192b;border:1px solid #5b7195;border-radius:10px;padding:12px;max-width:100%;box-sizing:border-box}form{display:flex;flex-wrap:wrap;gap:12px}input{flex:1;min-width:180px}a:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid #91e4f5;outline-offset:4px}
</style></head><body><header><nav aria-label="主要導覽"><a href={base}>✦ Cosmic Atelier</a><a href={`${base}articles/`}>文章</a><a href={`${base}gallery/`}>攝影</a><a href={`${base}apod/`}>APOD</a><a href={`${base}research/`}>研究</a><a href={`${base}search/`}>搜尋</a></nav></header><main><h1>{title}</h1><p>{description}</p><slot/></main><footer>Cosmic Atelier · Explore the Universe</footer></body></html>
