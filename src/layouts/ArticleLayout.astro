---
import { imageURL, jsonLD, dateISO } from '../lib/site.js';
const { title, description, date, category, cover }=Astro.props;
const canonical=new URL(Astro.url.pathname, Astro.site).toString();
const fullTitle=`${title}｜Cosmic Atelier 天文探索`;
const cats={'deep-sky':'深空觀測',research:'天文研究',equipment:'器材教學',basics:'天文知識'};
---
<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><link rel="canonical" href={canonical}/><title>{fullTitle}</title><meta name="twitter:card" content={cover?'summary_large_image':'summary'}/>{cover&&<meta property="og:image" content={new URL(imageURL(cover),Astro.site).href}/>}<meta property="og:type" content="article"/><meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><script type="application/ld+json" set:html={jsonLD({'@context':'https://schema.org','@type':'Article',headline:title,description:description,mainEntityOfPage:canonical,image:cover?new URL(imageURL(cover),Astro.site).href:undefined,datePublished:dateISO(date)||undefined,publisher:{'@type':'Organization',name:'Cosmic Atelier'}})}/><style is:global>
:root{color-scheme:dark}body{background:#070b17;color:#eaf0ff;font-family:system-ui,-apple-system,'Noto Sans TC',sans-serif;margin:0;line-height:1.85}header,main,footer{max-width:900px;margin:auto;padding:24px}header{border-bottom:1px solid #29344b;display:flex;justify-content:space-between;gap:12px}a{color:#86e3f7}header a{text-decoration:none;font-weight:700}article{max-width:760px;margin:auto}h1{font-size:clamp(2rem,5vw,3rem);line-height:1.25}h2{margin-top:2.3rem}p,li{color:#d4dcee}blockquote{border-left:3px solid #7de4f3;padding-left:20px;color:#bdd5e9}img{max-width:100%;height:auto;border-radius:12px} .lead{font-size:1.14rem;color:#b6c7de}.muted{color:#9baac2} .cover{width:100%;max-height:420px;object-fit:cover}footer{border-top:1px solid #29344b;color:#92a4c2}
</style></head><body><header><a href="/cosmic-atelier/">✦ COSMIC ATELIER</a><a href="/cosmic-atelier/articles/">文章專區 →</a></header><main><article><p class="muted">{cats[category]??'天文文章'} {dateISO(date) ? '・'+dateISO(date):''}</p><h1>{title}</h1><p class="lead">{description}</p>{cover&&<img class="cover" src={imageURL(cover)} decoding="async" alt={title}/>}<slot /></article></main><footer>Cosmic Atelier · Explore the Universe</footer></body></html>
