---
import { publishedArticle, slugOf } from '../../lib/site.js';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
export async function getStaticPaths(){
 const posts=Object.values(import.meta.glob('../../content/articles/*.md', { eager: true }));
 return posts.filter(publishedArticle).map(p=>({params:{slug:slugOf(p)},props:{post:p}}));
}
const {post}=Astro.props;
const {Content}=post;
---
<ArticleLayout title={post.frontmatter.title} description={post.frontmatter.description} category={post.frontmatter.category} date={post.frontmatter.date} cover={post.frontmatter.cover}><Content/></ArticleLayout>
