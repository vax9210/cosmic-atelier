---
import { dateISO, publishedArticle, slugOf } from '../../lib/site.js';
import CollectionSEO from '../../components/CollectionSEO.astro';
const posts=(Object.values(import.meta.glob('../../content/articles/*.md', { eager: true }))).filter(publishedArticle).sort((a,b)=>dateISO(b.frontmatter.date).localeCompare(dateISO(a.frontmatter.date)));
---
<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>天文文章與觀測筆記｜Cosmic Atelier</title><meta name="description" content="Cosmic Atelier 天文文章、觀測記錄、深空攝影、器材教學與國際研究中文導讀。"/><link rel="canonical" href="https://vax9210.github.io/cosmic-atelier/articles/"/><style>body{margin:0;background:#070b17;color:#eaf0ff;font:17px/1.8 system-ui,'Noto Sans TC',sans-serif}main{max-width:880px;margin:0 auto;padding:44px 20px}a{color:#7edff2}h1{font-size:clamp(2rem,6vw,3.5rem)}li{margin:22px 0;padding:17px 20px;border:1px solid #34415c;border-radius:14px}p{color:#bcc9df}</style><CollectionSEO title="天文文章與觀測筆記" description="Cosmic Atelier 原創天文觀測、攝影與科學探索。"/></head><body><main><a href="/cosmic-atelier/">← 返回宇宙首頁</a><h1>天文文章與觀測筆記</h1><p>探索深空天體、觀測技術與國際天文研究。</p>{posts.length===0?<p>第一篇文章正在準備中，敬請期待。</p>:<ul>{posts.map(p=><li><a href={`/cosmic-atelier/articles/${slugOf(p)}/`}>{p.frontmatter.title}</a><p>{p.frontmatter.description}</p></li>)}</ul>}</main></body></html>
